# Validated starting config (see docs/troubleshooting.md). gfx1151 = RDNA 3.5.
# Sourced by scripts/03-serve-vllm.sh.
#
# Single source of truth for the gfx1151 runtime environment. The adaptations vs
# a stock MI300X vLLM serve (the delta, fully explained in docs/adaptation.md):
#   * FLASH_ATTENTION_TRITON_AMD_ENABLE=TRUE — the Triton-on-AMD attention path
#     that works on RDNA 3.5 (gfx1151).
#   * VLLM_ROCM_USE_AITER intentionally NOT set — AITER is CDNA3+/RDNA4-only
#     (vLLM #51136); enabling it here falls back to broken emulation.
#   * HF_HUB_OFFLINE=1 — the model is fetched locally (scripts/02-fetch-model.sh);
#     never hit the network at serve time.
export FLASH_ATTENTION_TRITON_AMD_ENABLE=TRUE
export HF_HUB_OFFLINE=1
export VLLM_WORKER_MULTIPROC_METHOD=spawn
# VLLM_ROCM_USE_AITER intentionally NOT set — see comment above.

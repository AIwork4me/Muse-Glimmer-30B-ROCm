#!/usr/bin/env bash
# Shared config for the Muse-Glimmer-30B llama.cpp W7900 speed-test reproduction.
# Single Radeon PRO W7900 (gfx1100). Everything is overridable via env; no
# host-specific paths / GPU indices / download proxies are hard-coded.
#
# This package lives INSIDE the repo at scripts/w7900-repro/, so it reuses the
# committed harness (scripts/gguf-bench-cell.sh, scripts/bench_client.py, ...).
#
# Two reproduction methods (see README.md):
#   Method 1 (image)      ->  bash run_all.sh    (Docker; image has llama.cpp baked in)
#   Method 2 (bare metal) ->  bash run_host.sh   (you provide LLAMA_BIN_HOST)
#
# Model download (00_prepare.sh) uses the OFFICIAL Hugging Face. Network access
# is YOUR responsibility (set HF_ENDPOINT to a mirror yourself only if you must).

# --- Method 1: runtime image (built from ./Dockerfile: FROM flagos/flagtree-amd-tle:rocm7.2.4) ---
# Carries the prebuilt gfx1100 llama.cpp binaries at /llamacpp_workspace/bin.
#   docker build -t muse-glimmer-llamacpp:repro .   (stage bin/llama-server first; see bin/README.md)
# Or point IMAGE at any image that already ships a gfx1100 llama-server.
IMAGE="${IMAGE:-muse-glimmer-llamacpp:repro}"
CONTAINER="${CONTAINER:-muse_glimmer_w7900_repro}"

# --- Method 2: host llama.cpp server binary (gfx1100, llama.cpp >= b10353) ---
LLAMA_BIN_HOST="${LLAMA_BIN_HOST:-}"     # e.g. /opt/llama.cpp/build/bin/llama-server

# --- Paths (this package = <repo>/scripts/w7900-repro) ---
GLUE_DIR_HOST="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
REPO_DIR="${REPO_DIR:-$(git -C "$GLUE_DIR_HOST" rev-parse --show-toplevel 2>/dev/null || (cd "$GLUE_DIR_HOST/../.." && pwd))}"
GLUE_REL="${GLUE_DIR_HOST#$REPO_DIR/}"                            # scripts/w7900-repro
MODELS_HOST="${MODELS_HOST:-$REPO_DIR/models}"                    # gitignored (symlink or real dir)
OUT_HOST="${OUT_HOST:-$GLUE_DIR_HOST/_out/matrix-w7900-gfx1100}"  # gitignored

# --- Method 1 container paths (repo is mounted at /workspace) ---
WORKROOT_CONT="/workspace"
LLAMA_BIN_CONT="${LLAMA_BIN_CONT:-/llamacpp_workspace/bin/llama-server}"
MATRIX_OUTDIR_CONT="${MATRIX_OUTDIR_CONT:-/workspace/$GLUE_REL/_out/matrix-w7900-gfx1100}"

# --- Model download: OFFICIAL Hugging Face (no proxy / no mirror) ---
HF_REPO="${HF_REPO:-meta-models/Muse-Glimmer-30B-GGUF}"
HF_ENDPOINT="${HF_ENDPOINT:-}"           # empty = official huggingface.co

# --- Benchmark knobs ---
STUDY_CONF="${STUDY_CONF:-configs/gguf-bench/study2.conf}"

# --- ROCm docker flags for a single W7900 (Method 1) ---
# /dev/kfd + /dev/dri, auto-detected video/render GIDs, single GPU idx 0.
# Multi-GPU host? set HIP_VISIBLE_DEVICES=<n>.
rocm_device_flags() {
  local vg rg
  vg="$(getent group video  2>/dev/null | cut -d: -f3)"; vg="${vg:-44}"
  rg="$(getent group render 2>/dev/null | cut -d: -f3)"; rg="${rg:-993}"
  printf '%s' "--device=/dev/kfd --device=/dev/dri --group-add $vg --group-add $rg \
--security-opt seccomp=unconfined --ipc=host --shm-size=8g -e HIP_VISIBLE_DEVICES=${HIP_VISIBLE_DEVICES:-0}"
}

# Expected GGUF sizes (bytes) for integrity verification.
SZ_17GB=16756681056
SZ_DYNAMIC=19653957984
SZ_DFLASH=1631205312
SZ_MMPROJ=1400328928

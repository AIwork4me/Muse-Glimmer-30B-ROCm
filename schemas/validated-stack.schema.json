{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AIwork4me/Muse-Glimmer-30B-ROCm/schemas/validated-stack.schema.json",
  "title": "Validated stack manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "validated_on",
    "platform",
    "host",
    "python",
    "pytorch",
    "vllm",
    "llama_cpp",
    "model",
    "inference",
    "benchmark_evidence"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "validated-historical-reference"},
    "validated_on": {"type": "string", "format": "date"},
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hardware", "gpu_arch", "architecture_family", "compute_units", "memory"],
      "properties": {
        "hardware": {"type": "string", "minLength": 1},
        "gpu_arch": {"pattern": "^gfx[0-9]+$"},
        "architecture_family": {"type": "string", "minLength": 1},
        "compute_units": {"type": "integer", "minimum": 1},
        "memory": {"type": "string", "minLength": 1}
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_kernel", "observed_benchmark_kernels", "rocm_toolchain", "gpu_visible_memory_min_gib", "gpu_visible_memory_policy"],
      "properties": {
        "minimum_kernel": {"pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "observed_benchmark_kernels": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "rocm_toolchain": {"type": "string", "minLength": 1},
        "gpu_visible_memory_min_gib": {"type": "integer", "minimum": 1},
        "gpu_visible_memory_policy": {"type": "string", "minLength": 1}
      }
    },
    "python": {"$ref": "#/$defs/versionObject"},
    "pytorch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "version", "torchvision", "runtime_rocm_line"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "torchvision": {"type": "string", "minLength": 1},
        "runtime_rocm_line": {"type": "string", "minLength": 1}
      }
    },
    "vllm": {"$ref": "#/$defs/engine"},
    "llama_cpp": {"$ref": "#/$defs/engine"},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bf16_id", "bf16_revision", "gguf_id", "gguf_revision", "artifact_manifest"],
      "properties": {
        "bf16_id": {"type": "string", "minLength": 1},
        "bf16_revision": {"$ref": "#/$defs/sha1"},
        "gguf_id": {"type": "string", "minLength": 1},
        "gguf_revision": {"$ref": "#/$defs/sha1"},
        "artifact_manifest": {"const": "configs/artifact-manifest.json"}
      }
    },
    "inference": {"type": "object", "minProperties": 1},
    "benchmark_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rocm_7_2_1_matrix", "methodology", "rocm_7_14_status"],
      "properties": {
        "rocm_7_2_1_matrix": {"const": "docs/results/matrix/"},
        "methodology": {"const": "docs/results/METHODOLOGY.md"},
        "rocm_7_14_status": {"const": "pending"}
      }
    }
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "versionObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {"version": {"type": "string", "minLength": 1}}
    },
    "engine": {
      "type": "object",
      "required": ["source_repo", "commit", "build_arch"],
      "properties": {
        "source_repo": {"type": "string", "format": "uri"},
        "commit": {"$ref": "#/$defs/sha1"},
        "build_arch": {"pattern": "^gfx[0-9]+$"},
        "upstream_pr": {"type": "string", "format": "uri"},
        "patches": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
